# Local development only. Before deploying, replace with the verified HTTPS
# production origin assigned to this project. No path, query or fragment.
SITE_URL=http://localhost:3000

# Optional exact additional browser origins allowed to submit a brief.
# Comma-separated absolute origins; never wildcards. Leave empty unless needed.
# The platform-provided VERCEL_URL is trusted separately by the brief endpoint.
APP_ALLOWED_ORIGINS=

# Set false to return a truthful 503 from brief preparation while retaining pages.
BRIEF_ENABLED=true

# VERCEL, VERCEL_ENV and VERCEL_URL are supplied by Vercel. Do not commit tokens
# or manually set these platform variables in production. No database or mail
# credentials are needed. Changes to SITE_URL or indexing environment need a build.
